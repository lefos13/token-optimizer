{
  "mcpServers": {
    "token_optimizer": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/start.js"
      ],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY:-}",
        "OPENROUTER_MODEL": "${OPENROUTER_MODEL:-}",
        "LOCAL_LLM_API_URL": "http://localhost:8080/v1",
        "LOCAL_LLM_MODEL": "local-model"
      }
    }
  }
}
