{
  "mcpServers": {
    "token_optimizer": {
      "command": "node",
      "args": [
        "server/start.js"
      ],
      "cwd": ".",
      "env_vars": [
        "OPENROUTER_API_KEY",
        "OPENROUTER_MODEL",
        "OPENROUTER_API_URL",
        "TOKEN_OPTIMIZER_PROVIDER_MODE"
      ],
      "env": {
        "LOCAL_LLM_API_URL": "http://localhost:8080/v1",
        "LOCAL_LLM_MODEL": "local-model"
      }
    }
  }
}
