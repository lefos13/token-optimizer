{
  "token_optimizer": {
    "type": "local",
    "command": [
      "node",
      "${HOME}/.config/opencode/token-optimizer-server/start.js"
    ],
    "environment": {
      "OPENROUTER_API_KEY": "{env:OPENROUTER_API_KEY}",
      "OPENROUTER_MODEL": "{env:OPENROUTER_MODEL}"
    },
    "enabled": true
  }
}
